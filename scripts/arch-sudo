#!/bin/sh
# Run a command as root. sudo gets the password from .env on its stdin (never in
# argv, never printed); the rest of this script's stdin reaches the command, so
# the installer's typed confirmation still works.
set -eu
# shellcheck disable=SC1091
. "$(dirname "$0")/env.sh"
[ -n "${ARCH_SUDO_PASSWORD:-}" ] || { echo "ARCH_SUDO_PASSWORD is not set in .env" >&2; exit 1; }
{ printf '%s\n' "$ARCH_SUDO_PASSWORD"; cat; } | sudo -S -p '' --preserve-env=ARCH_ADMIN_PASSWORD,DRY_RUN "$@"
